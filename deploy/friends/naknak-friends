#!/usr/bin/env bash
# naknak-friends — host naknak for friends next to your own instance.
#
# One container and one data volume per friend, pinned to the friend's NAK
# account (NAK_OWNER), reachable only through your reverse proxy / SSO. The
# list lives in friends.conf next to compose.yml:
#
#   # slug   NAK username
#   max      20123
#   erika    20456
#   demo     demo      ← invented data, no NAK account (test the chain)
#
#   naknak-friends render    write friends.yml (compose services) from friends.conf
#   naknak-friends up        render + start/refresh every friend instance
#   naknak-friends update    pull the image; on a new one restart all instances,
#                            wait for health, roll each back on failure
#   naknak-friends list      show instances and their health
#
# Env: NAKNAK_DIR (default: this script's directory), NAKNAK_IMAGE,
# NAK_OPERATOR / NAK_OPERATOR_CONTACT (shown to friends: who runs it).
set -euo pipefail
DIR=${NAKNAK_DIR:-$(cd "$(dirname "$0")" && pwd)}
IMG=${NAKNAK_IMAGE:-ghcr.io/raindancer118/nak-api:edge}
CONF=$DIR/friends.conf
OUT=$DIR/friends.yml
log() { echo "naknak-friends: $*"; }

friends() { # slug owner, comments and blanks skipped, validated
  [ -f "$CONF" ] || return 0
  local n=0
  while read -r slug owner rest; do
    n=$((n + 1))
    [ -z "${slug:-}" ] || [ "${slug:0:1}" = "#" ] && continue
    if ! [[ $slug =~ ^[a-z][a-z0-9-]{1,30}$ ]] || ! [[ ${owner:-} =~ ^[0-9A-Za-z._-]{3,40}$ ]]; then
      echo "naknak-friends: $CONF line $n: want '<slug> <NAK username>' (slug: a-z, 0-9, -)" >&2
      exit 2
    fi
    echo "$slug $owner"
  done <"$CONF"
}

render() {
  local tmp
  tmp=$(mktemp "$DIR/.friends.XXXXXX")
  {
    echo "# generated by naknak-friends from friends.conf — do not edit"
    echo "services:"
    while read -r slug owner; do
      local cmd=serve
      [ "$owner" = demo ] && cmd="serve --demo"
      cat <<YML
  naknak-$slug:
    image: $IMG
    command: $cmd
    restart: unless-stopped
    environment:
      NAK_OWNER: "$owner"
      NAK_TRUST_PROXY: "1"
      NAK_OPERATOR: "${NAK_OPERATOR:-}"
      NAK_OPERATOR_CONTACT: "${NAK_OPERATOR_CONTACT:-}"
      TZ: Europe/Berlin
    volumes:
      - naknak-$slug-data:/data
    read_only: true
    tmpfs: [/tmp]
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    mem_limit: 256m
    stop_grace_period: 15s
    logging: { driver: json-file, options: { max-size: 5m, max-file: "2" } }
YML
    done < <(friends)
    echo "volumes:"
    while read -r slug _; do echo "  naknak-$slug-data:"; done < <(friends)
  } >"$tmp"
  # an empty list must still be valid compose (counted, not piped into grep -q:
  # with pipefail an early-closing grep makes the pipeline fail at random)
  if [ "$(friends | wc -l)" -eq 0 ]; then printf '# generated by naknak-friends — no friends yet\nservices: {}\n' >"$tmp"; fi
  mv "$tmp" "$OUT"
  chmod 600 "$OUT"
}

compose() { docker compose --project-directory "$DIR" -f "$DIR/compose.yml" -f "$OUT" "$@"; }

wait_healthy() { # container → 0 when healthy within 90 s
  local s
  for _ in $(seq 1 45); do
    s=$(docker inspect -f '{{.State.Health.Status}}' "$1" 2>/dev/null || echo missing)
    [ "$s" = healthy ] && return 0
    sleep 2
  done
  return 1
}

services() { friends | while read -r slug _; do echo "naknak-$slug"; done; }

container() { compose ps -q "$1" 2>/dev/null | head -1; }

case "${1:-}" in
render) render; log "wrote $OUT ($(services | wc -l) instances)" ;;
up)
  render
  mapfile -t svc < <(services)
  [ ${#svc[@]} -gt 0 ] || { log "no friends in $CONF"; exit 0; }
  compose up -d "${svc[@]}"
  for s in "${svc[@]}"; do wait_healthy "$(container "$s")" && log "$s healthy" || log "$s NOT healthy"; done
  ;;
update)
  render
  mapfile -t svc < <(services)
  [ ${#svc[@]} -gt 0 ] || exit 0
  before=$(docker image inspect -f '{{.Id}}' "$IMG" 2>/dev/null || true)
  docker pull -q "$IMG" >/dev/null
  after=$(docker image inspect -f '{{.Id}}' "$IMG")
  # also start instances that were added since the last update
  missing=0
  for s in "${svc[@]}"; do [ -n "$(container "$s")" ] || missing=1; done
  [ "$before" = "$after" ] && [ $missing = 0 ] && exit 0
  [ -n "$before" ] && [ "$before" != "$after" ] && docker tag "$before" naknak-friends:previous
  compose up -d "${svc[@]}"
  failed=()
  for s in "${svc[@]}"; do wait_healthy "$(container "$s")" || failed+=("$s"); done
  [ ${#failed[@]} = 0 ] && { log "all ${#svc[@]} healthy"; exit 0; }
  log "NOT healthy: ${failed[*]} — rolling back"
  if docker image inspect naknak-friends:previous >/dev/null 2>&1; then
    docker tag naknak-friends:previous "$IMG"
    compose up -d "${failed[@]}"
  fi
  exit 1
  ;;
list)
  friends | while read -r slug owner; do
    c=$(container "naknak-$slug")
    printf '%-20s %-12s %s\n' "$slug" "$owner" "$([ -n "$c" ] && docker inspect -f '{{.State.Health.Status}}' "$c" || echo "not running")"
  done
  ;;
*) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
