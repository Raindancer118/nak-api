# ~/.config/naknak/friends.env — settings for naknak-friend (not in git)
NAKNAK_DOMAIN=naknak.example.org        # friends get <slug>.$NAKNAK_DOMAIN (wildcard DNS → proxy)
APP_SSH=apphost                         # ssh host running compose.yml + naknak-friends
APP_DIR=/srv/naknak
AUTH_SSH=authhost                       # ssh host of Authentik (docker compose project)
AUTH_DIR=/srv/authentik
TEMPLATE_PROVIDER=naknak                # your own naknak proxy provider, copied for friends
OUTPOST=naknak                          # Authentik outpost serving the instances
PROXY_SSH=proxyhost                     # ssh host of NPMplus
NPM_USER=admin@example.org
NPM_PASSWORD_CMD='pass show npm'        # prints the NPM password (bw, pass, …)
FORWARD_HOST=10.0.0.5                   # where NPMplus reaches the outpost
FORWARD_PORT=3087
