# NORDAKADEMIE login (CIS and Moodle use the same account)
CIS_USER=
CIS_PASS=
# Only if your Moodle login differs:
# MOODLE_USER=
# MOODLE_PASS=

# Access token for the web UI. Leave empty to have one generated on first
# start; it is printed in the log (docker compose logs nak) and kept in the
# volume.
NAK_WEB_TOKEN=

# 1 = block every binding action (registrations, submissions, profile edits)
NAK_READONLY=0
